# NexusIQ environment configuration
#
# Fresh provider-keyless install:
#
#   ./install.sh --start
#   ./doctor.sh
#
# NEXUS_AEON_ENABLED=false is the default. Leave provider fields blank in core
# mode. To add memory, configure a provider, set NEXUS_AEON_ENABLED=true, and
# re-run ./install.sh then ./start.sh.
#
# Never commit a populated .env. Internal secrets are generated only when the
# selected mode needs them; NEXUS_AGENTD_AUTH_TOKEN is always generated.

# -----------------------------------------------------------------------------
# ─────────────────────────────────────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────────────────────────────────────

# Tracing verbosity for both Rust services (aeon + nexus-agentd).
# Examples: info | debug | "debug,sqlx=warn,hyper=warn" | trace
RUST_LOG=info

# Run the Nexus containers as this host user so ./data stays writable from the host.
# install.sh sets these to your current id -u / id -g automatically.
NEXUSIQ_UID=1000
NEXUSIQ_GID=1000


# ─────────────────────────────────────────────────────────────────────────────
# IMAGES + BUILD
# ─────────────────────────────────────────────────────────────────────────────
# When a prebuilt image with the given tag exists, compose uses it; otherwise
# it builds from the corresponding build context.

# Nexus image (provides nexus, nexus-agentd, nexus-mcp).
NEXUS_IMAGE=nexusiq-nexus:local
# AEON-IQ image (provides memoryos).
AEON_IQ_IMAGE=nexusiq-aeon:local

# Build contexts (vendored source trees populated by install.sh).
NEXUS_BUILD_CONTEXT=./vendor/nexus
AEON_BUILD_CONTEXT=./vendor/aeon-iq


# ─────────────────────────────────────────────────────────────────────────────
# POSTGRES  (internal only — never published to the host)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=nexusiq
POSTGRES_DB=nexusiq
# auto-generated by install.sh when memory is enabled — leave blank
POSTGRES_PASSWORD=

# NOTE: AEON's DATABASE_URL is DERIVED inside docker-compose.yml from the three
# POSTGRES_* values above:
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# The password therefore lives in exactly one place. Do not set DATABASE_URL.


# ─────────────────────────────────────────────────────────────────────────────
# AEON-IQ  (memoryos-kernel server)
# ─────────────────────────────────────────────────────────────────────────────

# Management API key. Protects AEON's management endpoints.
# auto-generated by install.sh when memory is enabled — leave blank
MANAGEMENT_API_KEY=

# Ed25519 seed AEON-IQ uses to counter-sign memory-search evidence
# (generated by install.sh / scripts/generate-secrets.sh).
AEON_EVIDENCE_SIGNING_KEY=

# AEON-IQ's PUBLIC evidence verifying key. Read it once the stack is up:
#   curl -s -H "X-Management-Key: $MANAGEMENT_API_KEY" \
#     http://127.0.0.1:8080/api/v1/evidence/verifying-key
# then paste the key_id here and restart the nexus services. When set, Nexus
# verifies every memory-search response's counter-signature and only reports
# Attested* memory-evidence modes on success.
NEXUS_AEON_VERIFYING_KEY=

# Allow management calls without the key. Keep false in any real deployment.
ALLOW_UNAUTH_MANAGEMENT=false

# Embedding vector width. MUST match both the embedding model AND the pgvector
# column width in AEON's migrations (hard-coded to 1536). Do not change unless
# you also alter the schema — see .env.ollama.example for the caveats.
EMBEDDING_DIMENSION=1536

# Retrieval / rate-limit / DB tuning (sensible defaults).
RETRIEVAL_THRESHOLD=0.80
RATE_LIMIT_RPM=0            # 0 = disabled
RATE_LIMIT_BURST=20
DB_MAX_CONNECTIONS=20
MAX_BODY_BYTES=10485760     # 10 MiB


# ─────────────────────────────────────────────────────────────────────────────
# NEXUS  (client — agentd + mcp)
# ─────────────────────────────────────────────────────────────────────────────

# Memory is opt-in. Only true or false (case-insensitive) is accepted.
NEXUS_AEON_ENABLED=false

# Internal service URL — use the compose service name, NOT localhost.
NEXUS_AEON_BASE_URL=http://aeon:8080

# ── IMPORTANT CROSS-WIRING ───────────────────────────────────────────────────
# NEXUS_AEON_MANAGEMENT_KEY (the Nexus side) MUST equal MANAGEMENT_API_KEY (the
# AEON side) — they are the same shared secret. docker-compose.yml already wires
# the Nexus services to read ${MANAGEMENT_API_KEY}, so you only set it ONCE
# (above, in the AEON-IQ section). install.sh keeps them in sync. There is no
# separate NEXUS_AEON_MANAGEMENT_KEY variable to fill in here.
# ─────────────────────────────────────────────────────────────────────────────

# HMAC signing key for Nexus → AEON requests.
# auto-generated by install.sh — leave blank
NEXUS_AEON_HMAC_KEY=

# Identity used when writing/reading memory.
NEXUS_AEON_AGENT_ID=nexusiq
NEXUS_AEON_SESSION_ID=default

# Client timeout for AEON calls (milliseconds).
NEXUS_AEON_TIMEOUT_MS=5000

# agentd auth token (shared between nexus-agentd and nexus-mcp).
# auto-generated by install.sh — leave blank
NEXUS_AGENTD_AUTH_TOKEN=

# agentd socket path (inside the shared ./data/run bind mount). Both services agree.
NEXUS_AGENTD_SOCKET=/run/nexus/nexus-agentd.sock

# Module directories (container paths; backed by ./data/modules on the host).
NEXUS_AGENTD_MODULE_DIR=/modules
NEXUS_MCP_MODULE_DIR=/modules


# ─────────────────────────────────────────────────────────────────────────────
# LLM PROVIDER
# ─────────────────────────────────────────────────────────────────────────────
# Supported UPSTREAM_PROVIDER values: openai | anthropic | gemini | ollama
#
# ── MVP default: openai (1536-dim embeddings, no schema changes needed) ──
#
# Gemini and Ollama use non-1536-dim embedding models and require a schema
# change to migrations/0001_initial.sql BEFORE the first install.
# See .env.gemini.example and .env.ollama.example for the full procedure.
# Treat those as ADVANCED / OPT-IN paths until dynamic dimensions are added.

UPSTREAM_PROVIDER=openai

# Base URLs for chat/extraction + embeddings. Defaults target OpenAI.
UPSTREAM_BASE_URL=https://api.openai.com
EMBEDDING_BASE_URL=https://api.openai.com
EXTRACTOR_BASE_URL=https://api.openai.com

# Models.
EMBEDDING_MODEL=text-embedding-3-small
EXTRACTOR_MODEL=gpt-4o-mini

# Provider API key. Required only when memory is explicitly enabled with the
# default `openai` provider. AEON will not
# be able to embed or extract memories without it. For anthropic / gemini, see
# the matching .env.<provider>.example for the right base URLs and models.
OPENAI_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# PORTS  (all host bindings are loopback-only)
# ─────────────────────────────────────────────────────────────────────────────
# AEON HTTP API → 127.0.0.1:${AEON_PORT}:8080
AEON_PORT=8080
